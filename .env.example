# Sentinel AI Environment Configuration Example
PROJECT_NAME="Sentinel AI"
ENVIRONMENT="production"
PORT=8000

# Anomaly Detection & Risk Scoring
ANOMALY_THRESHOLD=0.70
CRITICAL_RISK_THRESHOLD=0.85
AUTO_BLOCK_CRITICAL=true
AUTO_BLOCK_DURATION_HOURS=24

# Notifications
ADMIN_EMAIL="security-admin@yourstore.com"
ADMIN_PHONE="+1-555-019-9876"
SLACK_WEBHOOK_URL=""
DISCORD_WEBHOOK_URL=""

# Database & Cache (Optional production overrides)
DATABASE_URL="sqlite:///backend/app/storage/sentinel.db"
REDIS_URL="redis://localhost:6379/0"
